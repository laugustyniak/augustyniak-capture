<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ rules (android:dataExtractionRules), for both cloud backup and
  device-to-device transfer. Nothing is eligible, for the reasons in
  backup_rules.xml; both files are kept in step. See docs/platform-setup.md (#300).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
