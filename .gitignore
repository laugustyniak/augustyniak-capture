# Machine-specific paths written by `flutter pub get` / the platform builds.
# These embed the absolute SDK + project path of whoever ran the tool last,
# so tracking them makes every Linux<->Windows switch a spurious diff.
# All of them are regenerated automatically — never commit them.
android/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/

# Release signing. `key.properties` holds the keystore passwords in plaintext
# and the keystore itself is the one artifact that cannot be regenerated — lose
# it and no future build can ever update an app already on Play. Keep both out
# of the repo (see `android/key.properties.example`); the patterns are broad on
# purpose, so a keystore dropped anywhere in the tree is still ignored.
android/key.properties
*.jks
*.p12
*.keystore

# Superpowers brainstorm tooling state
.superpowers/

# Worktrees created by Claude Code sessions — each is its own git repo.
.claude/worktrees/

# A byte-for-byte copy of CLAUDE.md kept for another agent CLI. Two files
# holding the same guidance drift apart the first time one is edited, so the
# copy stays local rather than becoming a second source of truth in the repo.
gemini.md
