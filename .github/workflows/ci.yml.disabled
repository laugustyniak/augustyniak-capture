# DISABLED — GitHub Actions is metered on this private repo and the account's
# Actions budget blocked every job before it started. Development is local for
# now: `flutter pub get && flutter analyze && flutter test`, plus
# `flutter build windows --debug` for the desktop-only features.
#
# To re-enable: rename this file back to `ci.yml` and uncomment the body.
# The `.disabled` suffix is what actually keeps it inert — GitHub only reads
# `.yml`/`.yaml` in this directory. A commented-out `ci.yml` would still be
# picked up and reported as an invalid workflow ("no event triggers defined in
# `on`") on every push.
#
# name: CI
#
# on:
#   push:
#     branches: [main]
#   pull_request:
#
# concurrency:
#   group: ci-${{ github.ref }}
#   cancel-in-progress: true
#
# jobs:
#   # Fast gate: the whole test suite is pure Dart (bar one testWidgets file), so
#   # it needs no platform toolchain and runs on Linux.
#   analyze-and-test:
#     name: Analyze + test
#     runs-on: ubuntu-latest
#     steps:
#       - uses: actions/checkout@v4
#
#       - uses: subosito/flutter-action@v2
#         with:
#           channel: stable
#           cache: true
#
#       - run: flutter --version
#
#       - run: flutter pub get
#
#       # analysis_options.yaml: flutter_lints + avoid_print + prefer_final_locals.
#       # Left at the default severity on purpose — the job's job right now is to
#       # catch compile errors, not to fail on a pre-existing lint info.
#       - name: Analyze
#         run: flutter analyze
#
#       - name: Test
#         run: flutter test
#
#   # Slow gate, and the one that actually matters for the desktop-only features
#   # (global hotkeys, OCR, video): it is the only step that compiles the native
#   # plugin registrations. Analyze alone would never catch a broken one.
#   #
#   # Note on cost if you re-enable: Windows runners bill at 2x the Linux rate.
#   build-windows:
#     name: Build Windows
