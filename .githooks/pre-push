#!/usr/bin/env bash
# Local stand-in for CI.
#
# GitHub Actions is metered on this private repo and the workflow is parked at
# .github/workflows/ci.yml.disabled, so nothing on the server gates a push.
# PR #9 shipped a branch that did not compile because of exactly that gap.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
# Skip a single push (e.g. pushing a WIP branch on purpose):
#   git push --no-verify
set -euo pipefail

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref being pushed. A branch deletion has an all-zero local sha and pushes no
# code, so there is nothing to analyze or test — skip unless at least one ref
# actually carries commits.
zero=0000000000000000000000000000000000000000
pushes_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" != "$zero" ]; then
    pushes_code=1
  fi
done
if [ "$pushes_code" = 0 ]; then
  echo "pre-push: only deletions — skipping checks"
  exit 0
fi

# git exports GIT_DIR (and friends) into its hooks. Flutter derives its own SDK
# version by running git inside its install directory, and an inherited GIT_DIR
# sends that lookup here instead — the SDK reports itself as `0.0.0-unknown`,
# every `sdk: flutter` constraint fails to solve, and the hook aborts the push
# with a version-solving error that has nothing to do with the branch. Clearing
# them is the documented fix and leaves the hook's own git usage unaffected: it
# runs in the worktree it was invoked from.
unset $(git rev-parse --local-env-vars)

echo "pre-push: flutter analyze"
if ! flutter analyze; then
  echo "pre-push: analyze failed — push aborted (use --no-verify to override)" >&2
  exit 1
fi

echo "pre-push: flutter test"
if ! flutter test; then
  echo "pre-push: tests failed — push aborted (use --no-verify to override)" >&2
  exit 1
fi

echo "pre-push: OK"
