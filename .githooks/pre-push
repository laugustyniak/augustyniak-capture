#!/usr/bin/env bash
# Local stand-in for CI.
#
# GitHub Actions is metered on this private repo and the workflow is parked at
# .github/workflows/ci.yml.disabled, so nothing on the server gates a push.
# PR #9 shipped a branch that did not compile because of exactly that gap.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
# Skip a single push (e.g. pushing a WIP branch on purpose):
#   git push --no-verify
set -euo pipefail

# Git exports GIT_DIR (and friends) into every hook. Flutter reads its own
# version by shelling out to git inside the SDK checkout, so with those set it
# inspects *this* repo instead, reports "0.0.0-unknown", and pub then rejects
# every plugin carrying a Flutter SDK constraint. The gate fails on a version
# solve that has nothing to do with the branch being pushed — which is worse
# than no gate, because the failure looks like the branch's fault.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

echo "pre-push: flutter analyze"
if ! flutter analyze; then
  echo "pre-push: analyze failed — push aborted (use --no-verify to override)" >&2
  exit 1
fi

echo "pre-push: flutter test"
if ! flutter test; then
  echo "pre-push: tests failed — push aborted (use --no-verify to override)" >&2
  exit 1
fi

echo "pre-push: OK"
