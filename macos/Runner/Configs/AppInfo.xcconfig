// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// This is what the Finder, the Dock and the menu bar show, so it carries the
// display name rather than the pubspec package name.
PRODUCT_NAME = Augustyniak Capture

// The binary inside the bundle, kept separate from the display name because
// PRODUCT_NAME now contains a space. Without this the executable is named
// `Augustyniak Capture` too, and every path that refers to it — TEST_HOST
// above all — has to carry that space. Renaming the product without setting
// this is what left TEST_HOST pointing at a bundle that is no longer built.
EXECUTABLE_NAME = augustyniak_capture

// The application's bundle identifier — the same identity as the Android
// applicationId and the iOS PRODUCT_BUNDLE_IDENTIFIER, and it must stay in
// step with them.
//
// It carried a different identifier until the rebrand; changing it is a
// re-identification rather than a rename, so an installed build does not
// upgrade across it. That was a deliberate, planned decision — see
// docs/plans/2026-08-04-augustyniak-capture-rebrand.md. Do not treat this line
// as freely editable: the next change costs every existing install again.
//
// `flutter create` would derive something like `ai.augustyniak.augustyniakCapture`
// from the org, which is a different app as far as any store or update
// mechanism is concerned.
PRODUCT_BUNDLE_IDENTIFIER = ai.augustyniak.capture

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Augustyniak AI. All rights reserved.
